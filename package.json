{
  "name": "porfolio",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev-server.js",
    "build": "vite build",
    "build:gh-pages": "GITHUB_PAGES=true vite build",
    "images:sync": "node scripts/sync-portfolio-images.js",
    "images:manifest": "node scripts/refresh-manifest.js",
    "images:optimize": "node scripts/optimize-portfolio-images.js",
    "preview": "npm run build && vite preview",
    "preview:gh-pages": "GITHUB_PAGES=true PAGES_REPO=Porfolio vite build && vite preview --base /Porfolio/",
    "preview:gh-pages:personal": "GITHUB_PAGES=true PAGES_REPO=portfolio vite build && vite preview --base /portfolio/"
  },
  "devDependencies": {
    "sharp": "^0.35.3",
    "vite": "^8.1.1"
  },
  "dependencies": {
    "@studio-freight/lenis": "^1.0.42",
    "gsap": "^3.15.0"
  }
}
